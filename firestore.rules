rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ledgers/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        return request.resource.data.keys().hasOnly(['revision', 'backup'])
          && request.resource.data.revision is int
          && request.resource.data.backup is string
          && request.resource.data.backup.size() <= 750000;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
